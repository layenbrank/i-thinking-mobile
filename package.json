{
  "name": "i-thinking",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "build:android": "eas build --platform android --profile development",
    "build:ios": "eas build --platform ios --profile development",
    "build:preview": "eas build --platform android --profile preview",
    "prod": "eas build --platform all --profile production",
    "prod:android": "eas build --platform android --profile production",
    "prod:ios": "eas build --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "update:prod": "eas update --branch production",
    "typecheck": "tsc --noEmit",
    "test": "jest --watchAll=false",
    "test:watch": "jest --watchAll",
    "test:ci": "jest --ci",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/config": "^1.1.20",
    "@gluestack-ui/nativewind-utils": "^1.0.28",
    "@gluestack-ui/themed": "^1.1.73",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/elements": "^2.9.39",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.18.9",
    "@tanstack/react-query": "^5.102.5",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^14.0.2",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "13.0.3",
    "expo-file-system": "^18.0.12",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-sharing": "^13.1.5",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.4.0",
    "lucide-react-native": "^1.34.0",
    "nativewind": "4.2.6",
    "pod-install": "^1.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.33.2",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.2",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "./jest.setup.ts"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|nativewind|react-native-css-interop|lucide-react-native))"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "\\.png$": "<rootDir>/__mocks__/fileMock.js",
      "^lucide-react-native$": "<rootDir>/__mocks__/lucide-react-native.js"
    }
  }
}
